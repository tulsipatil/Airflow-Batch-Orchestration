# ===== COPY THIS FILE TO .env AND FILL IN YOUR VALUES =====
# DO NOT COMMIT .env TO GIT - Add to .gitignore (already done)

# ===== AIRFLOW CONFIGURATION =====
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True
AIRFLOW__CORE__MAX_ACTIVE_RUNS_PER_DAG=1

# ===== DATABASE CONFIGURATION =====
# PostgreSQL (Local Docker)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# dbt Database Connection
DBT_POSTGRES_USER=airflow
DBT_POSTGRES_PASSWORD=airflow
DBT_POSTGRES_HOST=postgres
DBT_POSTGRES_PORT=5432
DBT_POSTGRES_DBNAME=airflow
DBT_POSTGRES_SCHEMA=analytics

# ===== EXTERNAL API CREDENTIALS =====

# Alpha Vantage API
# 1. Go to: https://www.alphavantage.co/
# 2. Sign up for free
# 3. Copy API key from dashboard
# 4. Paste below (includes rate limits: 5 calls/minute free)
ALPHA_VANTAGE_API_KEY=demo  # Replace with your actual key

# Finnhub API (Alternative - NOT IMPLEMENTED YET)
# 1. Go to: https://finnhub.io/
# 2. Sign up for free
# 3. Copy API key
FINNHUB_API_KEY=your_finnhub_key_here

# ===== SLACK ALERTING =====

# Slack Webhook URL (Recommended for this project)
# 1. Go to: https://api.slack.com/messaging/webhooks
# 2. Click "Create New App" → "From Scratch"
# 3. Name: "Airflow Alerts"
# 4. Select workspace
# 5. Go to "Incoming Webhooks" → Enable
# 6. Click "Add New Webhook to Workspace"
# 7. Select channel (e.g., #airflow-alerts)
# 8. Copy URL below
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack Bot Token (For message threads & advanced features)
# 1. From same app, go to "OAuth & Permissions"
# 2. Copy "Bot User OAuth Token"
SLACK_TOKEN=xoxb-your-bot-token

# Slack Channel for alerts
SLACK_CHANNEL=#airflow-alerts

# ===== EMAIL ALERTING =====

# Email Configuration (Using Gmail for example)
# For Gmail:
# 1. Go to: https://myaccount.google.com/apppasswords
# 2. Select "Mail" and "Windows Computer"
# 3. Copy the 16-character app password below
# 4. Do NOT use your regular Gmail password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
AIRFLOW_FROM_EMAIL=airflow@yourdomain.com
AIRFLOW_TO_EMAIL=alerts@yourdomain.com

# For other email providers:
# - Office 365: smtp.office365.com:587
# - SendGrid: smtp.sendgrid.net:587
# - AWS SES: email-smtp.REGION.amazonaws.com:587

# ===== AIRFLOW INTERNAL =====

# Fernet key (for encrypting secrets in Airflow)
# Pre-generated for development
# For production, generate new: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=d60OM4ZycYtzQQYsmayo3btiMMcJRnz82_DddiYnDc=

# Executor type
AIRFLOW__CORE__EXECUTOR=CeleryExecutor

# Redis URL for Celery task queue
AIRFLOW__CELERY__BROKER_URL=redis://redis:6379/0

# ===== DAG CONFIGURATION =====

# Schedule interval (cron or Airflow preset)
# Options: @daily, @hourly, @weekly, @monthly
# Or cron: '0 9 * * *' (9 AM UTC daily)
DAG_SCHEDULE_INTERVAL=@daily

# Number of retries for failed tasks
DAG_DEFAULT_RETRIES=2

# Wait time between retries (minutes)
DAG_RETRY_DELAY_MINUTES=5

# Maximum execution time per DAG run (minutes)
DAG_TIMEOUT_MINUTES=60

# ===== LOGGING =====

LOG_LEVEL=INFO
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO

# ===== ENVIRONMENT =====

ENVIRONMENT=development
DEBUG=False

# ===== STOCKS TO TRACK =====
# (Edit in airflow/dags/stock_data_pipeline.py if using API)
STOCK_SYMBOLS=AAPL,GOOGL,MSFT,TSLA,AMZN
